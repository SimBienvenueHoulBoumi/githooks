REQUIRES="mvn java"
# Dépendances (Spotless, JUnit) téléchargées d'avance, avec nouvelles tentatives :
# Maven Central renvoie parfois un « introuvable » passager. Le projet de départ
# est propre : seul le réseau peut faire échouer cette étape.
SETUP='for i in 1 2 3 4 5; do mvn -q -B spotless:check test && exit 0; sleep $((i * 10)); done; exit 1'
