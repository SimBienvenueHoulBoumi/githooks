{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": false,
  "packages": {
    ".": {
      "release-type": "simple",
      "changelog-sections": [
        { "type": "feat", "section": "Fonctionnalités" },
        { "type": "fix", "section": "Corrections" },
        { "type": "perf", "section": "Performances" },
        { "type": "docs", "section": "Documentation" },
        { "type": "refactor", "section": "Refactoring", "hidden": true },
        { "type": "test", "section": "Tests", "hidden": true },
        { "type": "ci", "section": "CI", "hidden": true },
        { "type": "chore", "section": "Maintenance", "hidden": true }
      ],
      "extra-files": [
        "action.yml",
        "README.md",
        "docs/index.md",
        "docs/ci.md",
        "docs/ci.en.md",
        "docs/index.en.md",
        "docs/releases.md",
        "docs/releases.en.md",
        "templates/gitlab/repogarde.gitlab-ci.yml",
        "templates/project/lefthook.yml",
        "templates/project/gitlab-ci.yml",
        "templates/project/.github/workflows/repogarde.yml",
        "templates/project/.github/workflows/release.yml",
        { "type": "json", "path": "package.json", "jsonpath": "$.version" }
      ]
    }
  }
}
