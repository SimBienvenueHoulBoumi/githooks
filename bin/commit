#!/usr/bin/env bash
# Assistant de commit conventionnel : guide l'en-tête, le corps et le pied.
#   git cc [options de git commit]     alias installé par install.sh
#   bin/commit --dry-run               affiche le message sans commiter
# Les réponses sont lues sur l'entrée standard (terminal, ou fichier/tube pour
# les tests). Le commit passe ensuite par les hooks habituels.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
# shellcheck source=../hooks/lib/common.sh
source "$ROOT/hooks/lib/common.sh"

DRY_RUN=""
if [ "${1:-}" = --dry-run ]; then
    DRY_RUN=1
    shift
fi

ask() { # $1 = question ; réponse dans REPLY
    printf '%s' "$1" >&2
    IFS= read -r REPLY || REPLY=""
}

if [ -z "$DRY_RUN" ] && git diff --cached --quiet; then
    echo "✖ Rien n'est stagé : ajoute d'abord tes modifications (git add …)." >&2
    exit 1
fi

TYPES=(feat fix docs style refactor perf test build ci chore revert)
DESCRIPTIONS=(
    "nouvelle fonctionnalité"
    "correction de bug"
    "documentation uniquement"
    "formatage, sans changement de logique"
    "restructuration sans changement de comportement"
    "amélioration de performance"
    "ajout ou modification de tests"
    "build, dépendances"
    "intégration continue"
    "maintenance diverse"
    "annulation d'un commit"
)

# Valeurs proposées d'après la branche : feat/panier → feat, panier
branch="$(git symbolic-ref --short HEAD 2>/dev/null || echo "")"
default_type="feat"
default_scope=""
if [[ "$branch" == */* ]]; then
    prefix="${branch%%/*}"
    case "$prefix" in feature) prefix=feat ;; bugfix | hotfix) prefix=fix ;; esac
    [[ "$prefix" =~ ^($CC_TYPES)$ ]] && default_type="$prefix"
    default_scope="$(echo "${branch#*/}" | tr '[:upper:]/' '[:lower:]-' | tr -cd 'a-z0-9._-')"
    [ "${#default_scope}" -le 20 ] || default_scope=""
fi

# 1. Type
echo "Type de changement :" >&2
for i in "${!TYPES[@]}"; do
    printf '  %2d) %-9s %s\n' "$((i + 1))" "${TYPES[$i]}" "${DESCRIPTIONS[$i]}" >&2
done
while :; do
    ask "Type [$default_type] : "
    answer="${REPLY:-$default_type}"
    if [[ "$answer" =~ ^[0-9]+$ ]] && [ "$answer" -ge 1 ] && [ "$answer" -le "${#TYPES[@]}" ]; then
        type="${TYPES[$((answer - 1))]}"
        break
    elif [[ "$answer" =~ ^($CC_TYPES)$ ]]; then
        type="$answer"
        break
    fi
    echo "  ✖ Choisis un numéro ou un type de la liste." >&2
done

# 2. Scope (optionnel)
while :; do
    if [ -n "$default_scope" ]; then
        ask "Scope (optionnel, « - » pour aucun) [$default_scope] : "
        scope="${REPLY:-$default_scope}"
        [ "$scope" = - ] && scope=""
    else
        ask "Scope (optionnel) : "
        scope="$REPLY"
    fi
    [[ -z "$scope" || "$scope" =~ ^[a-z0-9._-]+$ ]] && break
    echo "  ✖ Scope : minuscules, chiffres, . _ - uniquement." >&2
done

# 3. Changement incompatible (version majeure)
ask "Changement incompatible (version majeure) ? [o/N] : "
breaking=""
case "$REPLY" in o | O | oui | y | Y) breaking=1 ;; esac

header_prefix="$type${scope:+($scope)}${breaking:+!}: "

# 4. Description, avec contrôle de longueur de l'en-tête
authored_length "$header_prefix"
max=$((72 - REPLY))
while :; do
    ask "Description (${max} caractères max) : $header_prefix"
    description="$REPLY"
    if [ -z "$description" ]; then
        echo "  ✖ La description est obligatoire." >&2
        continue
    fi
    authored_length "$header_prefix$description"
    if [ "$REPLY" -gt 72 ]; then
        echo "  ✖ En-tête trop long : $REPLY caractères (72 max). Raccourcis la description." >&2
        continue
    fi
    break
done

# 5. Corps (optionnel, plusieurs lignes)
echo "Corps (optionnel) : explique le pourquoi ; ligne vide pour terminer." >&2
body=""
while :; do
    ask "> "
    [ -n "$REPLY" ] || break
    body="$body$REPLY"$'\n'
done

# 6. Pied : changement incompatible, références
footer=""
if [ -n "$breaking" ]; then
    while :; do
        ask "Décris le changement incompatible : "
        [ -n "$REPLY" ] && break
        echo "  ✖ Obligatoire pour un changement majeur." >&2
    done
    footer="BREAKING CHANGE: $REPLY"$'\n'
fi
ask "Références (optionnel, ex. Closes #12) : "
[ -z "$REPLY" ] || footer="$footer$REPLY"$'\n'

# Message final : en-tête, puis corps et pied séparés par une ligne vide
message="$header_prefix$description"$'\n'
[ -z "$body" ] || message="$message"$'\n'"$body"
[ -z "$footer" ] || message="$message"$'\n'"$footer"

echo >&2
echo "──── Message ────" >&2
printf '%s' "$message" >&2
echo "─────────────────" >&2

if [ -n "$DRY_RUN" ]; then
    printf '%s' "$message"
    exit 0
fi

ask "Commiter ? [O/n] : "
case "$REPLY" in n | N | non)
    echo "Abandonné : rien n'a été commité." >&2
    exit 1
    ;;
esac

file="$(mktemp)"
trap 'rm -f "$file"' EXIT
printf '%s' "$message" >"$file"
git commit -F "$file" "$@"
