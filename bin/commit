#!/usr/bin/env bash
# Assistant de commit conventionnel : guide l'en-tête, le corps et le pied.
#   git cc [options de git commit]     alias installé par install.sh
#   bin/commit --dry-run               affiche le message sans commiter
# Les réponses sont lues sur l'entrée standard (terminal avec édition de
# ligne, ou fichier/tube pour les tests). Le commit passe ensuite par les
# hooks habituels. Couleurs désactivables : NO_COLOR=1.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
# shellcheck source=../hooks/lib/common.sh
source "$ROOT/hooks/lib/common.sh"

DRY_RUN=""
if [ "${1:-}" = --dry-run ]; then
    DRY_RUN=1
    shift
fi

# Charte visuelle commune (hooks/lib/ui.sh, chargée par common.sh)
B="$UI_B" D="$UI_D" G="$UI_G" R="$UI_R" C="$UI_C" N="$UI_N"
STEPS=5

etape() { printf '\n%s◇ %s/%s%s  %s%s%s\n' "$C" "$1" "$STEPS" "$N" "$B" "$2" "$N" >&2; }
hint() { printf '  %s%s%s\n' "$D" "$*" "$N" >&2; }
fail() { printf '  %s✖ %s%s\n' "$R" "$*" "$N" >&2; }

# Réponse dans REPLY, nettoyée : séquences d'échappement (flèches, Échap) et
# caractères de contrôle retirés, espaces de début et de fin supprimés.
# Dans un terminal, édition de ligne (flèches, effacement) avec read -e.
ask() {
    if [ -t 0 ]; then
        IFS= read -e -r -p "$1" REPLY || REPLY=""
    else
        printf '%s' "$1" >&2
        IFS= read -r REPLY || REPLY=""
    fi
    REPLY="$(printf '%s' "$REPLY" | LC_ALL=C sed -e $'s/\x1b\\[[0-9;?]*[ -\\/]*[@-~]//g' -e $'s/\x1b.//g' |
        LC_ALL=C tr -d '\000-\010\013-\037\177')"
    REPLY="${REPLY#"${REPLY%%[![:space:]]*}"}"
    REPLY="${REPLY%"${REPLY##*[![:space:]]}"}"
}

if [ -z "$DRY_RUN" ] && git diff --cached --quiet; then
    fail "Rien n'est stagé : ajoute d'abord tes modifications (git add …)."
    exit 1
fi

TYPES=(feat fix docs style refactor perf test build ci chore revert)
# Emojis à la gitmoji : repères visuels du menu, jamais écrits dans le message
EMOJIS=(✨ 🐛 📝 🎨 ♻️ ⚡ ✅ 📦 👷 🔧 ⏪)
DESCRIPTIONS=(
    "nouvelle fonctionnalité"
    "correction de bug"
    "documentation uniquement"
    "formatage, sans changement de logique"
    "restructuration sans changement de comportement"
    "amélioration de performance"
    "ajout ou modification de tests"
    "build, dépendances"
    "intégration continue"
    "maintenance diverse"
    "annulation d'un commit"
)

# Valeurs proposées d'après la branche : feat/panier → feat, panier
branch="$(git symbolic-ref --short HEAD 2>/dev/null || echo "")"
first_commit=""
git rev-parse -q --verify HEAD >/dev/null || first_commit=1
default_type="feat"
default_scope=""
if [[ "$branch" == */* ]]; then
    prefix="${branch%%/*}"
    case "$prefix" in feature) prefix=feat ;; bugfix | hotfix) prefix=fix ;; esac
    [[ "$prefix" =~ ^($CC_TYPES)$ ]] && default_type="$prefix"
    default_scope="$(echo "${branch#*/}" | tr '[:upper:]/' '[:lower:]-' | tr -cd 'a-z0-9._-')"
    [ "${#default_scope}" -le 20 ] || default_scope=""
fi

brand "commit conventionnel" >&2
printf '%sEntrée = valeur proposée entre [crochets] · Ctrl+C pour abandonner%s\n' "$D" "$N" >&2

# 1. Type
etape 1 "Type de changement"
for i in "${!TYPES[@]}"; do
    printf '  %s%2d%s  %s  %s%-9s%s %s%s%s\n' "$D" "$((i + 1))" "$N" "${EMOJIS[$i]}" "$B" "${TYPES[$i]}" "$N" "$D" "${DESCRIPTIONS[$i]}" "$N" >&2
done
while :; do
    ask "Numéro ou nom [$default_type] : "
    answer="${REPLY:-$default_type}"
    if [[ "$answer" =~ ^[0-9]+$ ]] && [ "$answer" -ge 1 ] && [ "$answer" -le "${#TYPES[@]}" ]; then
        type="${TYPES[$((answer - 1))]}"
        break
    elif [[ "$answer" =~ ^($CC_TYPES)$ ]]; then
        type="$answer"
        break
    fi
    fail "« $answer » : choisis un numéro (1 à ${#TYPES[@]}) ou un nom de la liste."
done

# 2. Scope (optionnel)
etape 2 "Scope (optionnel)"
hint "Partie du projet concernée, ex. api, auth, chart ; Entrée pour aucun."
while :; do
    if [ -n "$default_scope" ]; then
        ask "Scope (« - » pour aucun) [$default_scope] : "
        scope="${REPLY:-$default_scope}"
        [ "$scope" = - ] && scope=""
    else
        ask "Scope : "
        scope="$REPLY"
    fi
    [[ -z "$scope" || "$scope" =~ ^[a-z0-9._-]+$ ]] && break
    fail "Scope : minuscules, chiffres, . _ - uniquement."
done

# 3. Changement incompatible (version majeure) : sans objet au premier commit
etape 3 "Changement incompatible ?"
breaking=""
breaking_note=""
if [ -n "$first_commit" ]; then
    hint "Premier commit du dépôt : rien d'existant à casser, question sautée."
else
    hint "Oui seulement si l'existant cesse de fonctionner pour ses utilisateurs"
    hint "(API, configuration, format, commande supprimés ou modifiés). Version majeure."
    ask "Incompatible ? [o/N] : "
    case "$REPLY" in o | O | oui | Oui | y | Y) breaking=1 ;; esac
    if [ -n "$breaking" ]; then
        hint "Ce qui casse et comment migrer (affiché dans les notes de version)."
        while :; do
            ask "Ce qui change : "
            if [ "${#REPLY}" -ge 10 ] && [[ ! "$REPLY" =~ ^(RAS|ras|rien|aucun|none|-|\.)$ ]]; then
                breaking_note="$REPLY"
                break
            fi
            fail "Décris le changement (10 caractères au moins) ; sinon, réponds non à la question précédente."
        done
    fi
fi

header_prefix="$type${scope:+($scope)}${breaking:+!}: "

# 4. Description, avec contrôle de longueur de l'en-tête
etape 4 "Description"
authored_length "$header_prefix"
max=$((72 - REPLY))
hint "À l'impératif, sans majuscule initiale ni point final ; $max caractères au plus."
while :; do
    ask "$header_prefix"
    description="$REPLY"
    description="${description%.}"
    if [ -z "$description" ]; then
        fail "La description est obligatoire."
        continue
    fi
    authored_length "$header_prefix$description"
    if [ "$REPLY" -gt 72 ]; then
        fail "En-tête trop long : $REPLY caractères (72 max). Raccourcis la description."
        continue
    fi
    break
done

# 5. Détails (optionnels) : corps puis références
etape 5 "Détails (optionnels)"
hint "Corps : explique le pourquoi, sur plusieurs lignes ; ligne vide pour terminer."
body=""
while :; do
    ask "> "
    [ -n "$REPLY" ] || break
    body="$body$REPLY"$'\n'
done
ask "Références (ex. Closes #12, Refs JIRA-42 ; Entrée pour aucune) : "
refs="$REPLY"

# Message final : en-tête, puis corps et pied séparés par une ligne vide
footer=""
[ -z "$breaking_note" ] || footer="BREAKING CHANGE: $breaking_note"$'\n'
[ -z "$refs" ] || footer="$footer$refs"$'\n'
message="$header_prefix$description"$'\n'
[ -z "$body" ] || message="$message"$'\n'"$body"
[ -z "$footer" ] || message="$message"$'\n'"$footer"

printf '\n%s┌─ Message ───────────────────────────────────────────────%s\n' "$D" "$N" >&2
while IFS= read -r line; do
    printf '%s│%s %s\n' "$D" "$N" "$line" >&2
done <<<"${message%$'\n'}"
printf '%s└─────────────────────────────────────────────────────────%s\n' "$D" "$N" >&2

if [ -n "$DRY_RUN" ]; then
    printf '%s' "$message"
    exit 0
fi

ask "Commiter ? [O/n] : "
case "$REPLY" in n | N | non | Non)
    printf '%sAbandonné : rien n%sa été commité.%s\n' "$D" "'" "$N" >&2
    exit 1
    ;;
esac

file="$(mktemp)"
trap 'rm -f "$file"' EXIT
printf '%s' "$message" >"$file"
git commit -F "$file" "$@"

# Suite : rappel de la convention de branches
cfg_r protectedBranches "main master"
if [[ " $REPLY " == *" $branch "* ]]; then
    printf '\n%s%s✔ Commit créé.%s Prochains changements : sur une branche, ex. %sgit switch -c %s/<sujet>%s, puis une PR.\n' \
        "$G" "$B" "$N" "$B" "$type" "$N" >&2
else
    printf '\n%s%s✔ Commit créé.%s Envoyer : %sgit push -u origin %s%s\n' "$G" "$B" "$N" "$B" "$branch" "$N" >&2
fi
