#!/usr/bin/env bash
# Met en place la publication npm automatique d'un dépôt, sans jeton : à
# chaque release, le workflow npm-publish.yml publie le paquet. npm vérifie
# que la publication vient bien de ce dépôt et de release.yml (publication de
# confiance, OIDC) et joint la provenance au paquet.
#
#   bin/npm-publication [--repo propriétaire/nom] [--workflow release.yml]
#                       [--environnement NOM]
#
# À lancer deux fois, tout passe par la pipeline :
# 1. paquet pas encore sur npm (la publication de confiance n'est possible que
#    sur un paquet existant) : jeton npm temporaire en secret NPM_TOKEN et
#    variable REPOGARDE_NPM=true ; la prochaine release publie le paquet ;
# 2. ensuite : éditeur de confiance sur npm (valeurs affichées), puis le
#    secret NPM_TOKEN est retiré. Les releases publient alors sans jeton.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
# shellcheck source=../hooks/lib/common.sh
source "$ROOT/hooks/lib/common.sh"

REPO=""
WORKFLOW="release.yml"
ENVIRONMENT=""
while [ $# -gt 0 ]; do
    case "$1" in
        --repo) shift; REPO="${1:?--repo attend propriétaire/nom}" ;;
        --workflow) shift; WORKFLOW="${1:?--workflow attend un fichier}" ;;
        --environnement | --environment) shift; ENVIRONMENT="${1:?--environnement attend un nom}" ;;
        -h | --help) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) err_t install.unknown_arg "$1"; exit 1 ;;
    esac
    shift
done

command -v gh >/dev/null || { err_t bot.no_gh; exit 1; }
command -v npm >/dev/null || { err_t npm.no_npm; exit 1; }
cd "$GIT_TOPLEVEL"
[ -f package.json ] || { err_t npm.no_package; exit 1; }
[ -n "$REPO" ] || REPO="$(gh repo view --json nameWithOwner -q .nameWithOwner)"
name="$(sed -n 's/^  "name": *"\([^"]*\)".*/\1/p' package.json | head -1)"

ouvrir() {
    echo "  → $1"
    if command -v open >/dev/null; then open "$1"
    elif command -v xdg-open >/dev/null; then xdg-open "$1" >/dev/null 2>&1
    elif command -v cmd.exe >/dev/null; then cmd.exe /c start "" "$1"
    fi
}
attendre() { t bot.press_enter; read -r -p "  $REPLY" _; }

brand "npm · $name · $REPO"

# Paquet absent de npm : la publication de confiance ne peut pas encore être
# configurée. La pipeline fait quand même la première publication, avec un
# jeton npm temporaire saisi par toi (secret NPM_TOKEN, jamais affiché).
if [ -z "$(npm view "$name" name 2>/dev/null || true)" ]; then
    step_t npm.step_token
    user="$(npm whoami 2>/dev/null || true)"
    if [ -n "$user" ]; then
        ouvrir "https://www.npmjs.com/settings/$user/tokens/granular-access-tokens/new"
    else
        ouvrir "https://www.npmjs.com/"
    fi
    dim_t npm.hint_token
    attendre
    t npm.ask_token
    echo "  $REPLY"
    gh secret set NPM_TOKEN --repo "$REPO"
    gh variable set REPOGARDE_NPM --repo "$REPO" --body true
    ok_t npm.token_done "$name"
    dim_t npm.hint_rerun
    exit 0
fi

# Paquet publié : publication de confiance (formulaire npm, rien de secret)
step_t npm.step_trust
ouvrir "https://www.npmjs.com/package/$name/access"
dim_t npm.hint_trust
echo "    Publisher        : GitHub Actions"
echo "    Organization/user: ${REPO%%/*}"
echo "    Repository       : ${REPO##*/}"
echo "    Workflow filename: $WORKFLOW"
echo "    Environment name : ${ENVIRONMENT:-—}"
dim_t npm.hint_tokens
attendre
gh variable set REPOGARDE_NPM --repo "$REPO" --body true

# Jeton de la première publication devenu inutile : retiré du dépôt
if gh secret list --repo "$REPO" | grep -q '^NPM_TOKEN'; then
    gh secret delete NPM_TOKEN --repo "$REPO"
    ok_t npm.token_removed
    dim_t npm.hint_revoke
fi
ok_t npm.done "$REPO"
