#!/usr/bin/env bash
# Point d'entrée unique de repogarde (paquet npm, ou clone du dépôt) :
#   repogarde install [--global] [--lang fr|en]   active les hooks (install.sh)
#   repogarde uninstall [--global] [--purge]      les retire
#   repogarde cc                                  assistant de commit
#   repogarde code-mort                           nouveau code mort de la branche
#   repogarde proteger [options]                  protection des branches (GitHub)
#   repogarde bot-release                         bot de release (GitHub App)
#   repogarde npm-publication                     publication npm automatique
#   repogarde --version
set -euo pipefail

# Dossier réel du paquet : npm appelle ce script via un lien symbolique
# (node_modules/.bin, préfixe global) ; readlink -f absent de macOS
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
    dir="$(cd "$(dirname "$src")" && pwd -P)"
    src="$(readlink "$src")"
    case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
ROOT="$(cd "$(dirname "$src")/.." && pwd -P)"
# shellcheck source=../hooks/lib/ui.sh
source "$ROOT/hooks/lib/ui.sh"
# shellcheck source=../hooks/lib/i18n.sh
source "$ROOT/hooks/lib/i18n.sh"

aide() { sed -n '2,10p' "$ROOT/bin/repogarde" | sed 's/^# \{0,1\}//'; }

commande="${1:-}"
[ $# -eq 0 ] || shift
case "$commande" in
    install)
        # npx : paquet dans un cache temporaire, effaçable à tout moment ;
        # des hooks globaux y pointeraient vers un dossier disparu
        if [[ " $* " == *" --global "* && "$ROOT" == */_npx/* ]]; then
            err_t npm.npx_global
            exit 1
        fi
        exec bash "$ROOT/install.sh" "$@"
        ;;
    uninstall) exec bash "$ROOT/install.sh" --uninstall "$@" ;;
    cc | commit) exec bash "$ROOT/bin/commit" "$@" ;;
    code-mort | deadcode) exec bash "$ROOT/bin/code-mort" "$@" ;;
    proteger | protect) exec bash "$ROOT/bin/proteger" "$@" ;;
    bot-release) exec bash "$ROOT/bin/bot-release" "$@" ;;
    npm-publication | npm-publish) exec bash "$ROOT/bin/npm-publication" "$@" ;;
    -v | --version | version)
        sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' "$ROOT/package.json" | head -1
        ;;
    "" | -h | --help | help) aide ;;
    *)
        err_t install.unknown_arg "$commande"
        aide >&2
        exit 1
        ;;
esac
