#!/usr/bin/env bash
# Travailler à partir d'un ticket : le ticket d'abord, la branche en découle.
#   repowarden ticket <n>                    se place sur la branche du ticket ; la crée,
#                                            liée au ticket, si elle n'existe pas encore
#   repowarden ticket nouveau "<titre>" [--type fix] [--description "…"]
#                                            crée le ticket (« à valider » si le suivi
#                                            est géré par repowarden, sinon avec sa branche)
#   repowarden ticket                        ticket de la branche courante
# Demande un gh connecté (https://cli.github.com).
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
# shellcheck source=../hooks/lib/common.sh
source "$ROOT/hooks/lib/common.sh"
# shellcheck source=../hooks/lib/tickets.sh
source "$ROOT/hooks/lib/tickets.sh"

aide() { sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; }

[ -n "$GIT_TOPLEVEL" ] || { err_t install.not_repo; exit 1; }
cd "$GIT_TOPLEVEL"

# Branche d'où partent les tickets : integrationBranch, sinon la branche par
# défaut du dépôt distant
base_r() {
    cfg_r integrationBranch ""
    [ -z "$REPLY" ] || return 0
    REPLY="$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null || echo origin/main)"
    REPLY="${REPLY#origin/}"
}

# REPLY = branche distante du ticket $1 (type/<n>-…), vide si aucune
remote_branch_r() {
    local ref
    REPLY=""
    while IFS= read -r ref; do
        ref="${ref#origin/}"
        branch_ticket_r "$ref"
        if [ "$REPLY" = "$1" ]; then REPLY="$ref"; return 0; fi
        REPLY=""
    done < <(git for-each-ref --format='%(refname:short)' refs/remotes/origin)
}

# Se place sur la branche $1 (locale, ou suivie depuis origin)
switch_to() {
    if git show-ref -q --verify "refs/heads/$1"; then
        git switch -q "$1"
    else
        git switch -q --track -c "$1" "origin/$1"
    fi
}

cmd_ticket() {
    local n="$1" json etat titre etiquettes base
    command -v gh >/dev/null || { err_t bot.no_gh; exit 1; }
    step_t tk.cli.fetch "$n"
    git fetch -q origin --prune
    remote_branch_r "$n"
    if [ -n "$REPLY" ]; then
        switch_to "$REPLY"
        ok_t tk.cli.switched "$REPLY" "$n"
        return 0
    fi
    json="$(gh issue view "$n" --json state,title,labels \
        -q '[.state, .title, ([.labels[].name] | join("\n"))] | @tsv')"
    IFS=$'\t' read -r etat titre etiquettes <<<"$json"
    etiquettes="${etiquettes//\\n/$'\n'}"
    if [ "$etat" != OPEN ]; then
        err_t tk.cli.closed "$n"
        exit 1
    fi
    # Suivi géré par repowarden : la branche naît de la validation
    if tickets_managed && ! grep -qxF "$VALIDE" <<<"$etiquettes"; then
        err_t tk.cli.not_validated "$n" "$VALIDE"
        exit 1
    fi
    ticket_type_r "$etiquettes"
    ticket_branch_r "$n" "$titre" "$REPLY"
    local branche="$REPLY"
    base_r
    base="$REPLY"
    gh issue develop "$n" --name "$branche" --base "$base" --checkout >/dev/null
    ok_t tk.cli.created_branch "$branche" "$base" "$n"
}

cmd_nouveau() {
    local titre="" type="" description="" porcelain="" url n etiquettes=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --type) shift; type="${1:?--type attend un type}" ;;
            --description) shift; description="${1:?--description attend un texte}" ;;
            --porcelain) porcelain=1 ;;
            -*) err_t install.unknown_arg "$1"; exit 1 ;;
            *) titre="$1" ;;
        esac
        shift
    done
    [ -n "$titre" ] || { err_t tk.cli.title_required; exit 1; }
    command -v gh >/dev/null || { err_t bot.no_gh; exit 1; }
    if tickets_managed; then
        etiquettes+=(--label "$S_AVALIDER")
        [ -z "$type" ] || etiquettes+=(--label "type: $type")
    fi
    _tr tk.cli.issue_body
    url="$(gh issue create --title "$titre" --body "${description:-$_T}" ${etiquettes[@]+"${etiquettes[@]}"})"
    n="${url##*/}"
    if [ -n "$porcelain" ]; then
        echo "$n"
        return 0
    fi
    if tickets_managed; then
        ok_t tk.cli.issue_created "$n" "$n"
    else
        # Sans suivi automatique, pas d'étape de validation : la branche suit
        ok_t tk.cli.issue_created_branch "$n"
        ticket_branch_r "$n" "$titre" "${type:-feat}"
        local branche="$REPLY"
        base_r
        gh issue develop "$n" --name "$branche" --base "$REPLY" --checkout >/dev/null
        ok_t tk.cli.created_branch "$branche" "$REPLY" "$n"
    fi
}

case "${1:-}" in
    -h | --help | help) aide ;;
    nouveau | new) shift; cmd_nouveau "$@" ;;
    "")
        branche="$(git symbolic-ref --short HEAD 2>/dev/null || echo "")"
        branch_ticket_r "$branche"
        if [ -n "$REPLY" ]; then
            info_t tk.cli.current "$branche" "$REPLY"
        else
            ticket_hint "$branche"
        fi
        ;;
    *)
        if [[ "$1" =~ ^#?[0-9]+$ ]]; then
            cmd_ticket "${1#\#}"
        else
            err_t install.unknown_arg "$1"
            aide >&2
            exit 1
        fi
        ;;
esac
