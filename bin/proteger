#!/usr/bin/env bash
# Protège le dépôt GitHub courant d'après .repogarde.conf (relançable sans risque) :
#   - branches protectedBranches : PR obligatoire, vérifications exigées à jour,
#     ni suppression ni push forcé (ruleset « repogarde ») ;
#   - merges : squash ; avec integrationBranch (flux develop), merge commit sur
#     main et branche par défaut develop ; titre de PR = message du commit ;
#   - tags v* : créés, déplacés ou supprimés uniquement par les workflows ;
#   - GitHub Actions autorisé à créer des PR (releases automatiques).
#
#   bin/proteger [--repo propriétaire/nom] [--checks "repogarde …"] [--dry-run]
# Demande un gh connecté avec les droits d'administration du dépôt.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
# shellcheck source=../hooks/lib/common.sh
source "$ROOT/hooks/lib/common.sh"

REPO=""
CHECKS="repogarde"
DRY_RUN=""
while [ $# -gt 0 ]; do
    case "$1" in
        --repo) shift; REPO="${1:?--repo attend propriétaire/nom}" ;;
        --checks) shift; CHECKS="${1:?--checks attend une liste}" ;;
        --dry-run) DRY_RUN=1 ;;
        -h | --help) sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) echo "Argument inconnu : $1" >&2; exit 1 ;;
    esac
    shift
done
[ -n "$REPO" ] || REPO="$(gh repo view --json nameWithOwner -q .nameWithOwner)"

cfg_r protectedBranches "main master"
protected="$REPLY"
cfg_r integrationBranch ""
integration="$REPLY"

# Branches protégées existant sur GitHub (main ou master selon le dépôt)
existing=""
for b in $protected; do
    gh api "repos/$REPO/branches/$b" --silent 2>/dev/null && existing="$existing $b"
done
[ -n "$existing" ] || { echo "✖ Aucune des branches « $protected » n'existe sur $REPO." >&2; exit 1; }

contexts=""
for c in $CHECKS; do contexts="$contexts {\"context\": \"$c\", \"integration_id\": 15368},"; done
contexts="${contexts%,}"

refs_json() { # branches → "refs/heads/a", "refs/heads/b"
    local b out=""
    for b in "$@"; do out="$out \"refs/heads/$b\","; done
    echo "${out%,}"
}

# Ruleset de branches : $1 nom, $2 branches (liste), $3 méthodes de merge (JSON)
branch_ruleset() {
    # shellcheck disable=SC2086 # liste de branches volontairement découpée
    cat <<JSON
{
  "name": "$1",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [{"actor_id": 5, "actor_type": "RepositoryRole", "bypass_mode": "pull_request"}],
  "conditions": {"ref_name": {"include": [$(refs_json $2)], "exclude": []}},
  "rules": [
    {"type": "deletion"},
    {"type": "non_fast_forward"},
    {"type": "pull_request", "parameters": {
      "allowed_merge_methods": [$3],
      "dismiss_stale_reviews_on_push": true,
      "require_code_owner_review": false,
      "require_last_push_approval": false,
      "required_approving_review_count": 0,
      "required_review_thread_resolution": true}},
    {"type": "required_status_checks", "parameters": {
      "strict_required_status_checks_policy": true,
      "do_not_enforce_on_create": false,
      "required_status_checks": [$contexts]}}
  ]
}
JSON
}

# Tags de version : posés uniquement par les workflows (GitHub Actions)
tags_ruleset='{
  "name": "repogarde (tags)",
  "target": "tag",
  "enforcement": "active",
  "bypass_actors": [{"actor_id": 15368, "actor_type": "Integration", "bypass_mode": "always"}],
  "conditions": {"ref_name": {"include": ["refs/tags/v*"], "exclude": []}},
  "rules": [{"type": "creation"}, {"type": "update"}, {"type": "deletion"}]
}'

rulesets=()
if [ -n "$integration" ]; then
    # main : livraisons (develop, release/…, hotfix/…) en merge commit, pour
    # garder le détail des commits dans l'historique et les notes de version ;
    # develop : travail en squash, merge commit pour release/… et hotfix/…
    others=""
    for b in $existing; do [ "$b" = "$integration" ] || others="$others $b"; done
    [ -z "$others" ] || rulesets+=("$(branch_ruleset repogarde "$others" '"merge"')")
    [[ " $existing " != *" $integration "* ]] ||
        rulesets+=("$(branch_ruleset "repogarde ($integration)" "$integration" '"squash", "merge"')")
    merge_commit=true
    # Nettoyage par le workflow nettoyage-branches (garde une branche encore
    # source d'une autre PR ouverte)
    delete_on_merge=false
    methods="main : merge commit ; $integration : squash ou merge commit"
else
    rulesets+=("$(branch_ruleset repogarde "$existing" '"squash"')")
    merge_commit=false
    delete_on_merge=true
    methods="squash"
fi
rulesets+=("$tags_ruleset")

echo "Dépôt : $REPO"
echo "  branches protégées :$existing"
echo "  vérifications exigées : $CHECKS"
echo "  merges : $methods ; suppression auto des branches : $delete_on_merge"
echo "  tags v* : réservés aux workflows"
[ -z "$integration" ] || echo "  branche par défaut : $integration"
if [ -n "$DRY_RUN" ]; then
    printf '%s\n' "${rulesets[@]}"
    exit 0
fi

settings=(-F allow_squash_merge=true -F allow_merge_commit="$merge_commit" -F allow_rebase_merge=false
    -F delete_branch_on_merge="$delete_on_merge" -F allow_auto_merge=true
    -f squash_merge_commit_title=PR_TITLE -f squash_merge_commit_message=PR_BODY)
[ -z "$integration" ] || settings+=(-f default_branch="$integration")
gh api -X PATCH "repos/$REPO" --silent "${settings[@]}"
gh api -X PUT "repos/$REPO/actions/permissions/workflow" --silent \
    -f default_workflow_permissions=read -F can_approve_pull_request_reviews=true

for ruleset in "${rulesets[@]}"; do
    name="$(sed -n 's/^  "name": "\(.*\)",$/\1/p' <<<"$ruleset")"
    id="$(gh api "repos/$REPO/rulesets" --jq ".[] | select(.name == \"$name\") | .id")"
    if [ -n "$id" ]; then
        gh api -X PUT "repos/$REPO/rulesets/$id" --input - --silent <<<"$ruleset"
        echo "✔ Ruleset « $name » mis à jour."
    else
        gh api -X POST "repos/$REPO/rulesets" --input - --silent <<<"$ruleset"
        echo "✔ Ruleset « $name » créé."
    fi
done
echo "✔ Réglages appliqués."
