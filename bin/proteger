#!/usr/bin/env bash
# Protège le dépôt GitHub courant d'après .repowarden.conf (relançable sans risque) :
#   - branches protectedBranches : PR obligatoire, vérifications exigées à jour,
#     ni suppression ni push forcé (ruleset « repowarden ») ;
#   - merges : squash ; avec integrationBranch (flux develop), merge commit sur
#     main et branche par défaut develop ; titre de PR = message du commit ;
#   - tags v* : créés, déplacés ou supprimés uniquement par les workflows ;
#   - GitHub Actions autorisé à créer des PR (releases automatiques) ;
#   - validation humaine (optionnelle) : approbations obligatoires, revue des
#     CODEOWNERS, environnement de déploiement approuvé par des personnes.
#
#   bin/proteger [--repo propriétaire/nom] [--checks "repowarden,tests (ubuntu-latest)"] [--relecteurs N]
#                [--codeowners] [--environnement NOM] [--approbateurs "login …"]
#                [--sans-tags] [--dry-run]
# --sans-tags : dépôt qui déplace lui-même un tag (tag majeur flottant v2…).
# Réglages équivalents dans .repowarden.conf (requiredReviews, codeOwnerReview,
# environment, environmentReviewers). Demande un gh connecté, admin du dépôt.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
# shellcheck source=../hooks/lib/common.sh
source "$ROOT/hooks/lib/common.sh"

cfg_r requiredReviews 0
REVIEWS="$REPLY"
cfg_r codeOwnerReview false
CODEOWNERS="$REPLY"
cfg_r environment ""
ENVIRONMENT="$REPLY"
cfg_r environmentReviewers ""
APPROVERS="$REPLY"
REPO=""
CHECKS="repowarden"
DRY_RUN=""
NO_TAGS=""
while [ $# -gt 0 ]; do
    case "$1" in
        --repo) shift; REPO="${1:?--repo attend propriétaire/nom}" ;;
        --checks) shift; CHECKS="${1:?--checks attend une liste}" ;;
        --relecteurs) shift; REVIEWS="${1:?--relecteurs attend un nombre}" ;;
        --codeowners) CODEOWNERS=true ;;
        --environnement) shift; ENVIRONMENT="${1:?--environnement attend un nom}" ;;
        --approbateurs) shift; APPROVERS="${1:?--approbateurs attend des logins}" ;;
        --sans-tags) NO_TAGS=1 ;;
        --dry-run) DRY_RUN=1 ;;
        -h | --help) sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) err_t install.unknown_arg "$1"; exit 1 ;;
    esac
    shift
done
[ -n "$REPO" ] || REPO="$(gh repo view --json nameWithOwner -q .nameWithOwner)"
[[ "$REVIEWS" =~ ^[0-9]$ ]] || { err_t ci.proteger.reviews_invalid; exit 1; }
[[ "$CODEOWNERS" =~ ^(true|false)$ ]] || { err_t ci.proteger.codeowners_invalid; exit 1; }
# Avec relecture : le dernier à pousser ne peut pas approuver son propre push
last_push=false
[ "$REVIEWS" = 0 ] || last_push=true

cfg_r protectedBranches "main master"
protected="$REPLY"
cfg_r integrationBranch ""
integration="$REPLY"

# Branches protégées existant sur GitHub (main ou master selon le dépôt)
existing=""
for b in $protected; do
    # Nom renvoyé comparé : GitHub redirige une branche renommée (master → main)
    [ "$(gh api "repos/$REPO/branches/$b" --jq .name 2>/dev/null)" = "$b" ] && existing="$existing $b"
done
[ -n "$existing" ] || { err_t ci.proteger.no_branch "$protected" "$REPO"; exit 1; }

# Vérifications séparées par des virgules : un nom de job peut contenir des
# espaces (« tests (ubuntu-latest) »)
contexts=""
IFS=, read -ra checks <<<"$CHECKS"
for c in "${checks[@]}"; do
    c="${c#"${c%%[![:space:]]*}"}"
    c="${c%"${c##*[![:space:]]}"}"
    [ -n "$c" ] && contexts="$contexts {\"context\": \"$c\", \"integration_id\": 15368},"
done
contexts="${contexts%,}"

refs_json() { # branches → "refs/heads/a", "refs/heads/b"
    local b out=""
    for b in "$@"; do out="$out \"refs/heads/$b\","; done
    echo "${out%,}"
}

# Ruleset de branches : $1 nom, $2 branches (liste), $3 méthodes de merge (JSON),
# $4 PR à jour exigée (défaut true), $5 approbations (défaut REVIEWS),
# $6 dernier push approuvé par un autre (défaut selon REVIEWS)
branch_ruleset() {
    # shellcheck disable=SC2086 # liste de branches volontairement découpée
    cat <<JSON
{
  "name": "$1",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {"ref_name": {"include": [$(refs_json $2)], "exclude": []}},
  "rules": [
    {"type": "deletion"},
    {"type": "non_fast_forward"},
    {"type": "pull_request", "parameters": {
      "allowed_merge_methods": [$3],
      "dismiss_stale_reviews_on_push": true,
      "require_code_owner_review": $CODEOWNERS,
      "require_last_push_approval": ${6:-$last_push},
      "required_approving_review_count": ${5:-$REVIEWS},
      "required_review_thread_resolution": true}},
    {"type": "required_status_checks", "parameters": {
      "strict_required_status_checks_policy": ${4:-true},
      "do_not_enforce_on_create": false,
      "required_status_checks": [$contexts]}}
  ]
}
JSON
}

# Tags de version v*. Organisation : posés uniquement par les workflows
# (GitHub Actions en exception). Compte personnel : GitHub n'accepte pas
# cette exception ; un tag publié ne peut alors être ni déplacé ni supprimé
# (exception : administrateurs, tracée), sa création restant libre.
tags_ruleset() { # $1 : Organization ou User
    local bypass rules
    if [ "$1" = Organization ]; then
        bypass='{"actor_id": 15368, "actor_type": "Integration", "bypass_mode": "always"}'
        rules='{"type": "creation"}, {"type": "update"}, {"type": "deletion"}'
    else
        bypass='{"actor_id": 5, "actor_type": "RepositoryRole", "bypass_mode": "always"}'
        rules='{"type": "update"}, {"type": "deletion"}'
    fi
    cat <<JSON
{
  "name": "repowarden (tags)",
  "target": "tag",
  "enforcement": "active",
  "bypass_actors": [$bypass],
  "conditions": {"ref_name": {"include": ["refs/tags/v*"], "exclude": []}},
  "rules": [$rules]
}
JSON
}

rulesets=()
if [ -n "$integration" ]; then
    # main : livraisons (develop, release/…, hotfix/…) en merge commit, pour
    # garder le détail des commits dans l'historique et les notes de version ;
    # develop : travail en squash, merge commit pour release/… et hotfix/…
    others=""
    for b in $existing; do [ "$b" = "$integration" ] || others="$others $b"; done
    # Livraison vers main = passage à une nouvelle version : approbation
    # humaine obligatoire (la PR de livraison est ouverte par le workflow,
    # le mainteneur peut donc l'approuver), sans exiger un autre approbateur
    # que l'auteur du dernier push sauf si des relectures sont configurées
    livraison=$((REVIEWS > 0 ? REVIEWS : 1))
    # PR à jour non exigée non plus : le merge commit d'une livraison n'existe
    # que sur main ; strict, la livraison suivante serait bloquée tant que
    # develop ne l'a pas reçu (retour main → develop vide après chaque
    # release). Une livraison n'apporte que develop, vérifiée par la CI ; le
    # retour reste fait quand main a un contenu propre (correctif direct).
    [ -z "$others" ] || rulesets+=("$(branch_ruleset repowarden "$others" '"merge"' false "$livraison" "$last_push")")
    # Branche d'intégration : PR à jour non exigée. Le retour de main (après
    # une release) serait sinon presque toujours en retard, et « mettre à jour »
    # fusionnerait develop dans main en contournant la livraison ; la CI
    # vérifie de toute façon chaque push sur develop.
    [[ " $existing " != *" $integration "* ]] ||
        rulesets+=("$(branch_ruleset "repowarden ($integration)" "$integration" '"squash", "merge"' false)")
    merge_commit=true
    # Nettoyage par le workflow nettoyage-branches (garde une branche encore
    # source d'une autre PR ouverte)
    delete_on_merge=false
    # Merge automatique désactivé : aucune livraison programmée sans décision
    auto_merge=false
    # Sans ce workflow, les branches mergées ne seraient plus supprimées
    if ! grep -qs "nettoyage-branches.yml" "$GIT_TOPLEVEL"/.github/workflows/*.y*ml; then
        attention_t ci.proteger.no_cleanup
    fi
    t ci.proteger.methods_flow "$integration"
    methods="$REPLY"
else
    rulesets+=("$(branch_ruleset repowarden "$existing" '"squash"')")
    merge_commit=false
    auto_merge=true
    delete_on_merge=true
    methods="squash"
fi
owner_type="$(gh api "repos/$REPO" --jq .owner.type)"
if [ -z "$NO_TAGS" ]; then
    rulesets+=("$(tags_ruleset "$owner_type")")
    if [ "$owner_type" = Organization ]; then
        t ci.proteger.tags_org
        tags_msg="$REPLY"
    else
        t ci.proteger.tags_user
        tags_msg="$REPLY"
    fi
else
    t ci.proteger.tags_none
    tags_msg="$REPLY"
fi

echo_t ci.proteger.1 "$REPO"
echo_t ci.proteger.2 "$existing"
echo_t ci.proteger.3 "$CHECKS"
echo_t ci.proteger.4 "$methods" "$delete_on_merge"
[ -z "$integration" ] || echo_t ci.proteger.delivery "$livraison"
echo_t ci.proteger.5 "$tags_msg"
[ -z "$integration" ] || echo_t ci.proteger.6 "$integration"
echo_t ci.proteger.7 "$REVIEWS" "$CODEOWNERS"
if [ "$REVIEWS" != 0 ] || [ "$CODEOWNERS" = true ]; then
    echo_t ci.proteger.8
fi

# Environnement de déploiement : chaque job « environment: NOM » attend
# l'approbation d'une des personnes désignées ; déploiement seulement depuis
# les branches protégées et les tags v*
env_json=""
if [ -n "$ENVIRONMENT" ]; then
    [ -n "$APPROVERS" ] || APPROVERS="$(gh api user --jq .login)"
    reviewers=""
    # Personnes (login) ou équipes (@organisation/equipe : membres gérés dans GitHub)
    for login in $APPROVERS; do
        case "$login" in
            */*)
                team="${login#@}"
                id="$(gh api "orgs/${team%%/*}/teams/${team#*/}" --jq .id)" ||
                    { err_t ci.proteger.unknown_team "$login"; exit 1; }
                reviewers="$reviewers {\"type\": \"Team\", \"id\": $id},"
                ;;
            *)
                id="$(gh api "users/${login#@}" --jq .id)" || { err_t ci.proteger.unknown_user "$login"; exit 1; }
                reviewers="$reviewers {\"type\": \"User\", \"id\": $id},"
                ;;
        esac
    done
    # Seul approbateur = soi-même (projet solo) : l'auto-approbation reste permise
    self_review=true
    [ "$(wc -w <<<"$APPROVERS")" -gt 1 ] || self_review=false
    env_json="{\"reviewers\": [${reviewers%,}], \"prevent_self_review\": $self_review,
  \"deployment_branch_policy\": {\"protected_branches\": false, \"custom_branch_policies\": true}}"
    echo_t ci.proteger.9 "$ENVIRONMENT" "$APPROVERS"
fi
if [ -n "$DRY_RUN" ]; then
    printf '%s\n' "${rulesets[@]}"
    [ -z "$env_json" ] || printf '%s\n' "$env_json"
    exit 0
fi

settings=(-F allow_squash_merge=true -F allow_merge_commit="$merge_commit" -F allow_rebase_merge=false
    -F delete_branch_on_merge="$delete_on_merge" -F allow_auto_merge="$auto_merge"
    -f squash_merge_commit_title=PR_TITLE -f squash_merge_commit_message=PR_BODY)
[ -z "$integration" ] || settings+=(-f default_branch="$integration")
gh api -X PATCH "repos/$REPO" --silent "${settings[@]}"
gh api -X PUT "repos/$REPO/actions/permissions/workflow" --silent \
    -f default_workflow_permissions=read -F can_approve_pull_request_reviews=true

for ruleset in "${rulesets[@]}"; do
    name="$(sed -n 's/^  "name": "\(.*\)",$/\1/p' <<<"$ruleset")"
    # Ruleset posé sous l'ancien nom (repogarde, v3) : repris et renommé, sinon
    # il resterait à côté et exigerait une vérification « repogarde » disparue
    old="${name/repowarden/repogarde}"
    id="$(gh api "repos/$REPO/rulesets" \
        --jq "([.[] | select(.name == \"$name\")] + [.[] | select(.name == \"$old\")]) | .[0].id // empty")"
    if [ -n "$id" ]; then
        gh api -X PUT "repos/$REPO/rulesets/$id" --input - <<<"$ruleset" >/dev/null
        ok_t ci.proteger.10 "$name"
    else
        gh api -X POST "repos/$REPO/rulesets" --input - <<<"$ruleset" >/dev/null
        ok_t ci.proteger.11 "$name"
    fi
done
if [ -n "$env_json" ]; then
    gh api -X PUT "repos/$REPO/environments/$ENVIRONMENT" --input - --silent <<<"$env_json"
    policies="$(gh api "repos/$REPO/environments/$ENVIRONMENT/deployment-branch-policies" \
        --jq '.branch_policies[] | "\(.type):\(.name)"')"
    for policy in $(for b in $existing; do echo "branch:$b"; done) "tag:v*"; do
        grep -qxF "$policy" <<<"$policies" && continue
        gh api -X POST "repos/$REPO/environments/$ENVIRONMENT/deployment-branch-policies" --silent \
            -f type="${policy%%:*}" -f name="${policy#*:}"
    done
    ok_t ci.proteger.12 "$ENVIRONMENT"
fi
ok_t ci.proteger.13
