#!/usr/bin/env bash
# Hook pre-push : build/tests complets selon le(s) langage(s) détecté(s).
set -euo pipefail

source "$(dirname "$0")/lib/common.sh"
source "$(dirname "$0")/lib/lang.sh"
source "$(dirname "$0")/lib/safety.sh"
exit_if_skipped
check_version
cd "$GIT_TOPLEVEL"

# git fournit les refs poussées sur stdin : on les transmet au hook local
REFS="$(cat)"
printf '%s\n' "$REFS" | run_local_hook "$@"

# Nommage des branches poussées (ligne : <ref locale> <sha> <ref distante> <sha>).
# Une suppression (sha local nul) n'est pas vérifiée : retirer une branche mal
# nommée doit rester possible.
if ! skipped branch-name; then
    while read -r _ local_sha remote_ref _; do
        [[ "$remote_ref" == refs/heads/* ]] || continue
        [[ "$local_sha" =~ ^0+$ ]] && continue
        branch="${remote_ref#refs/heads/}"
        if ! branch_name_valid "$branch"; then
            err_t hook.pre_push.1 >&2
            branch_help "$branch"
            exit 1
        fi
    done <<< "$REFS"
fi

# Branches protégées : elles n'évoluent que par Pull Request. Seule la création
# initiale sur le remote est permise (dépôt neuf).
if ! skipped protect-branch; then
    cfg_r protectedBranches "main master"
    PROTECTED="$REPLY"
    while read -r _ _ remote_ref remote_sha; do
        [[ "$remote_ref" == refs/heads/* ]] || continue
        branch="${remote_ref#refs/heads/}"
        [[ " $PROTECTED " == *" $branch "* ]] || continue
        [[ "$remote_sha" =~ ^0+$ ]] && continue
        err_t hook.pre_push.2 "$branch" >&2
        echo_t hook.pre_push.3 >&2
        echo_t hook.pre_push.4 >&2
        exit 1
    done <<<"$REFS"
fi

skipped tests && { info "Tests désactivés (repowarden.skip)."; exit 0; }

# Shellcheck sur les fichiers shell modifiés (ticket #202)
# - shellcheck installé : s'exécute sur chaque fichier shell modifié, échec bloque le push
# - shellcheck non installé : signalé ; bloqué en CI stricte (REPOWARDEN_STRICT_SHELLCHECK)
skipped shellcheck && { info "Shellcheck désactivé (repowarden.skip)."; exit 0; }

REMOTE="${1:-origin}"

# Fichiers modifiés par le push de <sha> : depuis l'état distant connu, ou pour
# une nouvelle branche depuis le dernier commit déjà présent sur le remote.
changed_files() {
    local sha="$1" remote_sha="$2" oldest base=""
    if [[ ! "$remote_sha" =~ ^0+$ ]] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
        base="$remote_sha"
    else
        oldest="$(git rev-list "$sha" --not --remotes="$REMOTE" | tail -n1)"
        [ -z "$oldest" ] && return 0                       # déjà tout sur le remote
        base="$(git rev-parse -q --verify "$oldest^" || true)" # vide = premier push
    fi
    if [ -n "$base" ]; then
        git diff --name-only "$base" "$sha"
    else
        git ls-tree -r --name-only "$sha"
    fi
}

# Détecter les fichiers shell modifiés dans le push
changed_shell_files() {
    local sha="$1" remote_sha="$2" base=""
    if [[ ! "$remote_sha" =~ ^0+$ ]] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
        base="$remote_sha"
    else
        oldest="$(git rev-list "$sha" --not --remotes="$REMOTE" | tail -n1)"
        [ -z "$oldest" ] && return 0                       # déjà tout sur le remote
        base="$(git rev-parse -q --verify "$oldest^" || true)" # vide = premier push
    fi
    if [ -n "$base" ]; then
        git diff --name-only "$base" "$sha" | grep -E '\.sh$' || true
    else
        git ls-tree -r --name-only "$sha" | grep -E '\.sh$' || true
    fi
}

# Exécuter shellcheck sur les fichiers shell modifiés
shellcheck_modified() {
    local changed="$1"
    if [ -z "$changed" ]; then
        ok_t hook.pre_push.sc
        return 0
    fi
    # shellcheck disable=SC2086 # on veut exécuter shellcheck
    while IFS= read -r file; do
        [ -z "$file" ] && continue
        if ! shellcheck "$file" >/dev/null 2>&1; then
            err_t hook.pre_push.sc "$file"
            return 1
        fi
    done <<<"$changed"
    ok_t hook.pre_push.sc
}

# Lance les tests du projet touché. Lecture des fichiers modifiés sur stdin.
run_tests_for() {
    test_projects <"$1"
}

TESTED=""
CHANGED="$(git rev-parse --absolute-git-dir)/repowarden-changed-files"
while read -r _ local_sha _ remote_sha; do
    # suppression de branche : rien à tester
    if [ -z "$local_sha" ] || [[ "$local_sha" =~ ^0+$ ]]; then continue; fi
    [[ " $TESTED " == *" $local_sha "* ]] && continue
    TESTED="$TESTED $local_sha"
    changed_files "$local_sha" "$remote_sha" >"$CHANGED"
    if [ ! -s "$CHANGED" ] && [ -z "$(cfg test)" ]; then
        info_t hook.pre_push.5 "${local_sha:0:7}"
        continue
    fi
    # Teste le commit poussé tel qu'il sera sur le serveur
    run_on_commit "$local_sha" run_tests_for "$CHANGED"
    # Shellcheck sur les fichiers shell modifiés (même commande que en CI)
    modified_shell="$(changed_shell_files "$local_sha" "$remote_sha")"
    if [ -n "${REPOWARDEN_STRICT_SHELLCHECK:-}" ]; then
        # Mode strict : échec si shellcheck détecte des problèmes
        if [ -n "$modified_shell" ]; then
            if ! shellcheck_modified "$modified_shell" >/dev/null 2>&1; then
                err_t hook.pre_push.sc_fail "${local_sha:0:7}"
                rm -f "$CHANGED"
                exit 1
            fi
        fi
    else
        # Mode développeur : avertissement si shellcheck non installé ou des warnings
        if [ -n "$modified_shell" ]; then
            shellcheck_modified "$modified_shell" >/dev/null 2>&1 || true
        elif ! command -v shellcheck >/dev/null 2>&1; then
            warn "⚠ Shellcheck non installé (ajoutez REPOWARDEN_STRICT_SHELLCHECK=1 en CI pour bloquer)"
        fi
    fi
done <<<"$REFS"

rm -f "$CHANGED"
[ -n "$TESTED" ] || info_t hook.pre_push.6
ok_t hook.pre_push.7
