#!/usr/bin/env bash
# Hook pre-push : build/tests complets selon le(s) langage(s) détecté(s).
set -euo pipefail

source "$(dirname "$0")/lib/common.sh"
source "$(dirname "$0")/lib/lang.sh"
source "$(dirname "$0")/lib/safety.sh"
exit_if_skipped
cd "$(git rev-parse --show-toplevel)"

# git fournit les refs poussées sur stdin : on les transmet au hook local
REFS="$(cat)"
printf '%s\n' "$REFS" | run_local_hook "$@"

# Nommage des branches poussées (ligne : <ref locale> <sha> <ref distante> <sha>)
if ! skipped branch-name; then
    while read -r _ _ remote_ref _; do
        [[ "$remote_ref" == refs/heads/* ]] || continue
        branch="${remote_ref#refs/heads/}"
        if ! branch_name_valid "$branch"; then
            echo "✖ Push refusé : nom de branche non conforme." >&2
            branch_help "$branch"
            exit 1
        fi
    done <<< "$REFS"
fi

skipped tests && { echo "ℹ Tests désactivés (hooks.skip)."; exit 0; }

REMOTE="${1:-origin}"

# Fichiers modifiés par le push de <sha> : depuis l'état distant connu, ou pour
# une nouvelle branche depuis le dernier commit déjà présent sur le remote.
changed_files() {
    local sha="$1" remote_sha="$2" oldest base=""
    if [[ ! "$remote_sha" =~ ^0+$ ]] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
        base="$remote_sha"
    else
        oldest="$(git rev-list "$sha" --not --remotes="$REMOTE" | tail -n1)"
        [ -z "$oldest" ] && return 0                       # déjà tout sur le remote
        base="$(git rev-parse -q --verify "$oldest^" || true)" # vide = premier push
    fi
    if [ -n "$base" ]; then
        git diff --name-only "$base" "$sha"
    else
        git ls-tree -r --name-only "$sha"
    fi
}

run_tests_for() { test_projects <"$1"; }

TESTED=""
CHANGED="$(git rev-parse --absolute-git-dir)/githooks-changed-files"
while read -r _ local_sha _ remote_sha; do
    [ -n "$local_sha" ] && [[ ! "$local_sha" =~ ^0+$ ]] || continue # suppression
    [[ " $TESTED " == *" $local_sha "* ]] && continue
    TESTED="$TESTED $local_sha"
    changed_files "$local_sha" "$remote_sha" >"$CHANGED"
    if [ ! -s "$CHANGED" ] && [ -z "$(cfg test)" ]; then
        echo "ℹ ${local_sha:0:7} : aucun fichier modifié, rien à tester."
        continue
    fi
    # Teste le commit poussé tel qu'il sera sur le serveur
    run_on_commit "$local_sha" run_tests_for "$CHANGED"
done <<<"$REFS"

rm -f "$CHANGED"
[ -n "$TESTED" ] || echo "ℹ Rien à tester (suppression de branche uniquement)."
echo "✔ Pre-push OK"
