#!/usr/bin/env bash
# Hook pre-push : build/tests complets selon le(s) langage(s) détecté(s).
set -euo pipefail

source "$(dirname "$0")/lib/common.sh"
source "$(dirname "$0")/lib/lang.sh"
source "$(dirname "$0")/lib/safety.sh"
exit_if_skipped
cd "$(git rev-parse --show-toplevel)"

# git fournit les refs poussées sur stdin : on les transmet au hook local
REFS="$(cat)"
printf '%s\n' "$REFS" | run_local_hook "$@"

# Nommage des branches poussées (ligne : <ref locale> <sha> <ref distante> <sha>)
if ! skipped branch-name; then
    while read -r _ _ remote_ref _; do
        [[ "$remote_ref" == refs/heads/* ]] || continue
        branch="${remote_ref#refs/heads/}"
        if ! branch_name_valid "$branch"; then
            echo "✖ Push refusé : nom de branche non conforme." >&2
            branch_help "$branch"
            exit 1
        fi
    done <<< "$REFS"
fi

skipped tests && { echo "ℹ Tests désactivés (git config hooks.skip)."; exit 0; }

# Tests de tous les langages détectés dans le dossier courant
run_all_tests() {
    local langs lang
    langs="$(detect_languages)"
    if [ -z "$langs" ]; then
        echo "ℹ Aucun langage détecté, tests ignorés."
        return 0
    fi
    echo "ℹ Langage(s) détecté(s) :$langs"
    for lang in $langs; do
        if ! "test_$lang"; then
            echo "✖ Échec ($lang) : push refusé." >&2
            return 1
        fi
    done
}

SHAS="$(printf '%s\n' "$REFS" | pushed_shas)"
if [ -z "$SHAS" ]; then
    echo "ℹ Rien à tester (suppression de branche uniquement)."
    exit 0
fi

# Teste chaque commit poussé tel qu'il sera sur le serveur
for sha in $SHAS; do
    run_on_commit "$sha" run_all_tests
done

echo "✔ Pre-push OK"
