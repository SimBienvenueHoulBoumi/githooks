#!/usr/bin/env bash
# Hook post-merge (après git pull) : supprime les branches locales dont la
# branche distante a été supprimée (PR mergée) ET entièrement intégrées.
# `git branch -d` refuse toute branche contenant du travail non mergé : aucune
# perte possible. Désactivable : skip = prune-branches.
set -euo pipefail

source "$(dirname "$0")/lib/common.sh"
exit_if_skipped
delegate_to_lefthook "$@"
run_local_hook "$@"
skipped prune-branches && exit 0

current="$(git symbolic-ref --short HEAD 2>/dev/null || echo "")"
remote="$(git config --get "branch.$current.remote" || true)"
# Seulement après un pull (branche suivie) : met à jour la liste des branches
# supprimées sur le serveur. Hors ligne : ignoré silencieusement.
[ -n "$remote" ] || exit 0
git remote prune "$remote" >/dev/null 2>&1 || exit 0

git for-each-ref --format='%(refname:short)%09%(upstream:track)' refs/heads |
    while IFS=$'\t' read -r branch track; do
        [ "$track" = "[gone]" ] || continue
        [ "$branch" = "$current" ] && continue
        if git branch -d -q "$branch" 2>/dev/null; then
            echo "🧹 Branche locale supprimée (mergée et supprimée sur le serveur) : $branch"
        else
            echo "ℹ $branch : supprimée sur le serveur mais pas intégrée ici (merge squash ou rebase ?), conservée."
            echo "  Pour la supprimer quand même : git branch -D $branch"
        fi
    done
exit 0
