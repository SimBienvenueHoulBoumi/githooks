#!/usr/bin/env bash
# Hook commit-msg : impose le format Conventional Commits.
# Ex : "feat(auth): ajoute la connexion JWT", "fix: corrige le calcul de TVA"
set -euo pipefail

source "$(dirname "$0")/lib/common.sh"
exit_if_skipped
delegate_to_lefthook "$@"
run_local_hook "$@"

MSG_FILE="$1"
# Première ligne non commentée
SUBJECT="$(grep -v '^#' "$MSG_FILE" | sed -n 1p)"

# Commits générés par git : on laisse passer
if [[ "$SUBJECT" =~ ^(Merge|Revert|fixup!|squash!) ]]; then
    exit 0
fi

if ! [[ "$SUBJECT" =~ $CC_PATTERN ]]; then
    if [ "${REPOGARDE_LANG:-}" = en ]; then
        cat >&2 <<EOF
✖ Invalid commit message: "$SUBJECT"

Expected format: <type>(<optional scope>): <description>
  e.g.: feat(user): add sign-up
        fix: fix the database timeout
        refactor!: change the public API   (! = breaking change)

Types:
EOF
        types_help
        cat >&2 <<EOF

👉 Tip: name your branch <type>/<topic> (e.g. feat/user) and the prefix
   is added automatically: git commit -m "add sign-up"  (or use git cc)
   Your message is not lost: git commit -e -F .git/COMMIT_EDITMSG
EOF
    else
        cat >&2 <<EOF
✖ Message de commit invalide : "$SUBJECT"

Format attendu : <type>(<scope optionnel>): <description>
  ex. : feat(user): ajoute l'inscription
        fix: corrige le timeout de la base
        refactor!: change l'API publique   (! = breaking change)

Types :
EOF
        types_help
        cat >&2 <<EOF

👉 Astuce : nomme ta branche <type>/<sujet> (ex. feat/user) et le préfixe
   sera ajouté automatiquement : git commit -m "ajoute l'inscription"  (ou git cc)
   Ton message n'est pas perdu : git commit -e -F .git/COMMIT_EDITMSG
EOF
    fi
    exit 1
fi

authored_length "$SUBJECT"
if [ "$REPLY" -gt 72 ]; then
    err_t hook.commit_msg.1 "$REPLY" >&2
    exit 1
fi
